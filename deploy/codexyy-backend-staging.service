[Unit]
Description=Codexyy local staging backend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/codexyy/backend
Environment=CODEXYY_DB=/home/ubuntu/codexyy/staging/data.db
Environment=CODEXYY_BASE_URL=http://127.0.0.1:8876
Environment=CODEXYY_STAGING=1
Environment=GRAPH_SENDER=platform@codexyy.dev
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8876
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/codexyy/staging
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
