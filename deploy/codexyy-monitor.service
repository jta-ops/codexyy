[Unit]
Description=Evaluate Codexyy production health and alerts
After=codexyy-backend.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/codexyy/backend
LoadCredentialEncrypted=backend.env:/etc/credstore.encrypted/codexyy/backend.env
LoadCredentialEncrypted=graph-mail.env:/etc/credstore.encrypted/codexyy/graph-mail.env
ExecStart=/usr/bin/python3 /home/ubuntu/codexyy/backend/monitor_codexyy.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/codexyy
RestrictSUIDSGID=true
